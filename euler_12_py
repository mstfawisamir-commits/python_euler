def count_divisiors(number):
    count=0
    limit=int(number**0.5)
    for divisior in range(1,limit+1):
        if number%divisior==0:
            other_divisior=number//divisior
            if other_divisior==divisior:
                count+=1
            else:
                count+=2
    return(count)
triangular_number=0
add=1
while True:
    triangular_number+=add
    if count_divisiors(triangular_number)>=500:
        print(triangular_number)
        break
    add+=1
