numbers = []

for a in range(1, 1000000):
    p = a
    seq = [a]
    while p > 0:
        if p % 2 == 0:
            j = p // 2
        else:
            j = (p * 3) + 1
        
        seq.append(j)
        
        if j == 1:
            break
        else:
            p = j
            
    numbers.append(seq)
o=max(len(seq) for seq in numbers)
for seq in numbers:
    if len(seq) == o:
        print("Longest sequence is", seq, "with number", seq[0])
